rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Pure token/UID check for authorized developers & bootstrapped project owner (zero DB lookups)
    function isAuthorizedDeveloper() {
      return isSignedIn() && (
        request.auth.uid == 'eGi5P37ztLe5Nn77sEFvmFFcZWp1' ||
        request.auth.uid == 'ILSbnyLsRWXvV9n2viqoMgFyDpr2' ||
        (
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          'email' in request.auth.token &&
          (
            request.auth.token.email == 'abdulazizriadvip@gmail.com' ||
            request.auth.token.email == 'companycamerasinfinitycorp@gmail.com' ||
            request.auth.token.email == 'mohamed.m.alhasaneen@gmail.com'
          )
        )
      );
    }

    // Full admin check including Console-managed /admins collection lookup
    function isAdmin() {
      return isAuthorizedDeveloper() || (
        isSignedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint for Product (synced verbatim with firebase-blueprint.json)
    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'brand', 'category', 'shortDescription', 'description',
          'price', 'originalPrice', 'discountEnabled', 'inStock', 'isFeatured',
          'isPublished', 'images', 'specs', 'options', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'brand', 'category', 'categoryId', 'shortDescription', 'description',
          'price', 'originalPrice', 'discountEnabled', 'discountType', 'discountValue',
          'discountStartDate', 'discountEndDate', 'inStock', 'isFeatured',
          'isPublished', 'images', 'specs', 'options', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.brand is string && data.brand.size() <= 80 &&
        data.category is string && data.category.size() <= 80 &&
        (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 60)) &&
        data.shortDescription is string && data.shortDescription.size() <= 300 &&
        data.description is string && data.description.size() <= 3000 &&
        (data.price is int || data.price is float) && data.price > 0 && data.price <= 1000000 &&
        (data.originalPrice is int || data.originalPrice is float) && data.originalPrice >= data.price && data.originalPrice <= 1000000 &&
        data.discountEnabled is bool &&
        (!data.discountEnabled || data.originalPrice > data.price) &&
        (!('discountType' in data) || (data.discountType is string && data.discountType.size() <= 20 && data.discountType in ['percentage', 'fixed'])) &&
        (!('discountValue' in data) || ((data.discountValue is int || data.discountValue is float) && data.discountValue >= 0 && data.discountValue <= 1000000)) &&
        (!('discountStartDate' in data) || (data.discountStartDate is string && data.discountStartDate.size() <= 32)) &&
        (!('discountEndDate' in data) || (data.discountEndDate is string && data.discountEndDate.size() <= 32)) &&
        data.inStock is bool &&
        data.isFeatured is bool &&
        data.isPublished is bool &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 15 &&
        data.images[0] is string && data.images[0].size() >= 1 && data.images[0].size() <= 2000 &&
        data.specs is list && data.specs.size() <= 15 &&
        (data.specs.size() == 0 || (data.specs[0] is string && data.specs[0].size() >= 1 && data.specs[0].size() <= 200)) &&
        data.options is list && data.options.size() <= 10 &&
        (data.options.size() == 0 || (data.options[0] is string && data.options[0].size() <= 80)) &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // CEL-budget-optimized SiteConfig validator (~420 CEL expressions total vs 1,000 hard limit; <= 9 function calls vs 20 hard limit)
    function isValidSiteConfigGroup1(data) {
      return (data.id is string && data.id.size() <= 32 && data.id == 'main') &&
        (data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100) &&
        (data.primaryPhone is string && data.primaryPhone.size() >= 7 && data.primaryPhone.size() <= 30) &&
        (data.secondaryPhone is string && data.secondaryPhone.size() <= 30) &&
        (data.primaryWhatsApp is string && data.primaryWhatsApp.size() >= 7 && data.primaryWhatsApp.size() <= 25) &&
        ((data.whatsappUrl + data.afterSalesWhatsAppUrl + data.facebookUrl + data.instagramUrl + data.googleMapsUrl + data.partnerFacebookUrl).size() <= 3600) &&
        ((data.storeSubtitle + data.tagline + data.heroDescription + data.announcementText + data.closingPhrase).size() <= 3100) &&
        ((data.seoTitle + data.seoDescription + data.copyrightText + data.contactSectionTitle + data.contactSectionSubtitle).size() <= 1940) &&
        ((data.address + data.workingHours + data.shippingSummary + data.afterSalesPolicy).size() <= 5300);
    }

    function isValidSiteConfigGroup2(data) {
      return ((data.aboutStoreIntro + data.aboutPartnerIntro).size() <= 10000) &&
        ((data.partnerName + data.partnerSubtitle + data.partnerRoleTitle + data.partnerServiceScopeText).size() <= 1360) &&
        ((data.partnerOrderPhone1 + data.partnerOrderPhone2 + data.partnerMaintenancePhone + data.partnerAfterSalesPhone).size() <= 120) &&
        ((data.aboutHeroTitle + data.aboutHeroSubtitle + data.visionTitle + data.visionDescription).size() <= 4600) &&
        (data.showHeroSpotlight is bool && data.showValueStrip is bool) &&
        (data.showOffersSection is bool && data.showShippingSection is bool) &&
        (data.showPartnerCard is bool && data.showAboutBanner is bool) &&
        (!('showRatingsSection' in data) || data.showRatingsSection is bool) &&
        (data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 && data.updatedBy.matches('^[a-zA-Z0-9_\\-]+$')) &&
        (data.updatedAt is timestamp);
    }

    function isValidSiteConfigLists(data) {
      return (data.contactChannels is list && data.contactChannels.size() <= 20) &&
        (
          data.contactChannels.size() == 0 ||
          (
            data.contactChannels[0] is map &&
            data.contactChannels[0].keys().hasOnly(['id', 'label', 'role', 'owner', 'phone', 'whatsappUrl']) &&
            data.contactChannels[0].phone is string && data.contactChannels[0].phone.size() >= 7 && data.contactChannels[0].phone.size() <= 30
          )
        ) &&
        (data.socialLinks is list && data.socialLinks.size() <= 15) &&
        (
          data.socialLinks.size() == 0 ||
          (
            data.socialLinks[0] is map &&
            data.socialLinks[0].keys().hasOnly(['id', 'platform', 'label', 'owner', 'url']) &&
            data.socialLinks[0].url is string && data.socialLinks[0].url.size() >= 1 && data.socialLinks[0].url.size() <= 600
          )
        ) &&
        (data.branches is list && data.branches.size() <= 10) &&
        (
          data.branches.size() == 0 ||
          (
            data.branches[0] is map &&
            data.branches[0].keys().hasOnly(['id', 'name', 'address', 'mapUrl', 'workingHours', 'phone']) &&
            data.branches[0].name is string && data.branches[0].name.size() >= 1 && data.branches[0].name.size() <= 120
          )
        ) &&
        (data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 20) &&
        (
          data.categories[0] is map &&
          data.categories[0].keys().hasOnly(['id', 'name', 'order']) &&
          data.categories[0].id is string && data.categories[0].id.size() >= 1 && data.categories[0].id.size() <= 60 &&
          data.categories[0].name is string && data.categories[0].name.size() >= 2 && data.categories[0].name.size() <= 80 &&
          (data.categories[0].order is int || data.categories[0].order is float) &&
          data.categories[0].order >= 1 && data.categories[0].order <= 100
        ) &&
        (
          !('essentialCategories' in data) ||
          (
            data.essentialCategories is list &&
            data.essentialCategories.size() <= 20 &&
            (
              data.essentialCategories.size() == 0 ||
              (
                data.essentialCategories[0] is map &&
                data.essentialCategories[0].keys().hasOnly(['id', 'name', 'imageUrl', 'order']) &&
                data.essentialCategories[0].name is string && data.essentialCategories[0].name.size() >= 2 && data.essentialCategories[0].name.size() <= 80
              )
            )
          )
        );
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'id', 'storeName', 'primaryPhone', 'primaryWhatsApp', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeName', 'storeSubtitle', 'tagline', 'heroDescription',
          'announcementText', 'seoTitle', 'seoDescription', 'copyrightText',
          'primaryPhone', 'secondaryPhone', 'primaryWhatsApp', 'whatsappUrl',
          'afterSalesWhatsAppUrl', 'facebookUrl', 'instagramUrl', 'address',
          'googleMapsUrl', 'workingHours', 'shippingSummary', 'afterSalesPolicy',
          'closingPhrase', 'contactSectionTitle', 'contactSectionSubtitle',
          'partnerName', 'partnerSubtitle', 'partnerRoleTitle', 'partnerServiceScopeText',
          'partnerOrderPhone1', 'partnerOrderPhone2', 'partnerMaintenancePhone',
          'partnerAfterSalesPhone', 'partnerFacebookUrl', 'aboutHeroTitle',
          'aboutHeroSubtitle', 'aboutStoreIntro', 'aboutPartnerIntro', 'visionTitle',
          'visionDescription', 'contactChannels', 'socialLinks', 'branches', 'categories',
          'essentialCategories', 'showHeroSpotlight', 'showValueStrip', 'showOffersSection',
          'showShippingSection', 'showPartnerCard', 'showAboutBanner', 'showRatingsSection',
          'updatedBy', 'updatedAt'
        ]) &&
        isValidSiteConfigGroup1(data) &&
        isValidSiteConfigGroup2(data) &&
        isValidSiteConfigLists(data);
    }

    // Products Catalog Collection
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAuthorizedDeveloper();

      allow create: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().id == productId &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().id == productId &&
        (!('id' in existing()) || incoming().id == existing().id) &&
        (!('authorUid' in existing()) || !(existing().authorUid is string) || existing().authorUid.size() == 0 || incoming().authorUid == existing().authorUid) &&
        (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'brand', 'category', 'categoryId', 'shortDescription', 'description',
            'price', 'originalPrice', 'discountEnabled', 'discountType',
            'discountValue', 'discountStartDate', 'discountEndDate',
            'inStock', 'isFeatured', 'isPublished', 'images', 'specs',
            'options', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'category', 'categoryId',
            'price', 'originalPrice', 'discountEnabled', 'discountType',
            'discountValue', 'discountStartDate', 'discountEndDate',
            'inStock', 'isFeatured', 'isPublished', 'updatedAt'
          ])
        ) &&
        isAdmin();

      allow delete: if isSignedIn() && isValidId(productId) && isAdmin();
    }

    // Public Storefront & Contact Configuration Singleton (/siteConfig/main)
    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(request.resource.data) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(request.resource.data) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        isAdmin() &&
        (
          isAuthorizedDeveloper() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'storeName', 'storeSubtitle', 'tagline', 'heroDescription',
            'announcementText', 'seoTitle', 'seoDescription', 'copyrightText',
            'primaryPhone', 'secondaryPhone', 'primaryWhatsApp', 'whatsappUrl',
            'afterSalesWhatsAppUrl', 'facebookUrl', 'instagramUrl', 'address',
            'googleMapsUrl', 'workingHours', 'shippingSummary', 'afterSalesPolicy',
            'closingPhrase', 'contactSectionTitle', 'contactSectionSubtitle',
            'partnerName', 'partnerSubtitle', 'partnerRoleTitle', 'partnerServiceScopeText',
            'partnerOrderPhone1', 'partnerOrderPhone2', 'partnerMaintenancePhone',
            'partnerAfterSalesPhone', 'partnerFacebookUrl', 'aboutHeroTitle',
            'aboutHeroSubtitle', 'aboutStoreIntro', 'aboutPartnerIntro', 'visionTitle',
            'visionDescription', 'contactChannels', 'socialLinks', 'branches', 'categories',
            'essentialCategories', 'showHeroSpotlight', 'showValueStrip', 'showOffersSection',
            'showShippingSection', 'showPartnerCard', 'showAboutBanner', 'showRatingsSection',
            'updatedBy', 'updatedAt'
          ])
        );

      allow delete: if false;
    }

    // Locked Admin Membership Collection (client-side creation/mutation strictly forbidden)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && isAuthorizedDeveloper();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Read-only Connectivity & Live SiteConfig Validator Probe
    match /test/{probeId} {
      allow get: if isValidId(probeId) && (
        probeId == 'connection' ||
        probeId == 'rules_v3_ready' ||
        probeId == 'rules_v4_infinity_ready' ||
        probeId == 'rules_v6_ping' ||
        (
          probeId == 'rules_v5_siteconfig_ready' &&
          (
            !exists(/databases/$(database)/documents/siteConfig/main) ||
            isValidSiteConfig(get(/databases/$(database)/documents/siteConfig/main).data)
          )
        )
      );
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Public Store Statistics (/meta/visitors and /meta/ratings)
    match /meta/{statId} {
      allow get: if isValidId(statId) && (statId == 'visitors' || statId == 'ratings');
      allow list: if false;

      allow create: if isValidId(statId) && (
        (
          statId == 'visitors' &&
          incoming().keys().hasAll(['id', 'count']) &&
          incoming().keys().hasOnly(['id', 'count', 'updatedAt']) &&
          incoming().id == 'visitors' &&
          incoming().count == 1
        ) || (
          statId == 'ratings' &&
          incoming().keys().hasAll(['id', 'totalCount', 'totalStars', 'star1', 'star2', 'star3', 'star4', 'star5', 'recommendYes', 'recommendNo']) &&
          incoming().keys().hasOnly(['id', 'totalCount', 'totalStars', 'star1', 'star2', 'star3', 'star4', 'star5', 'recommendYes', 'recommendNo', 'updatedAt']) &&
          incoming().id == 'ratings' &&
          (incoming().totalCount is int || incoming().totalCount is float) && incoming().totalCount >= 1
        )
      );

      allow update: if isValidId(statId) && (
        (
          statId == 'visitors' &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['count']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['count', 'updatedAt'])
          ) &&
          (incoming().count is int || incoming().count is float) &&
          incoming().count == existing().count + 1 &&
          incoming().id == 'visitors'
        ) || (
          statId == 'ratings' &&
          incoming().id == 'ratings' &&
          (
            isAdmin() ||
            (
              (incoming().totalCount is int || incoming().totalCount is float) &&
              incoming().totalCount == existing().totalCount + 1
            )
          )
        )
      );

      allow delete: if false;
    }

    // Registry of Unique Device/Browser Instances (/uniqueDevices/{deviceId})
    match /uniqueDevices/{deviceId} {
      allow get: if isValidId(deviceId);
      allow list: if isAuthorizedDeveloper();
      allow create: if isValidId(deviceId) &&
        incoming().keys().hasAll(['id', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'createdAt', 'userAgent']) &&
        incoming().id == deviceId &&
        (!('userAgent' in incoming()) || (incoming().userAgent is string && incoming().userAgent.size() <= 300));
      allow update: if false;
      allow delete: if false;
    }

    // Individual Visitor Ratings Indexed By Unique Browser ID (/ratings/{ratingId})
    match /ratings/{ratingId} {
      allow get: if isValidId(ratingId);
      allow list: if isAuthorizedDeveloper() || isAdmin();
      allow create: if isValidId(ratingId) &&
        incoming().keys().hasAll(['id', 'stars', 'recommend', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'stars', 'recommend', 'createdAt']) &&
        incoming().id == ratingId &&
        (incoming().stars is int || incoming().stars is float) &&
        incoming().stars >= 1 && incoming().stars <= 5 &&
        incoming().recommend is bool &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
